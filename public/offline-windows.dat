<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Grand Group FZC Procurement</title>
    <meta name="description" content="Offline-first procurement document workstation for Grand Group FZC with live Excel pricing calculations, 3-variant Excel styling, Master Registry numbering, A4 print views, and styled .xlsx import/export." />
    <meta property="og:title" content="Grand Group FZC Procurement" />
    <meta property="og:description" content="Offline-first procurement document workstation for Grand Group FZC with live Excel pricing calculations, 3-variant Excel styling, Master Registry numbering, A4 print views, and styled .xlsx import/export." />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1B365D" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="GG Procure" />
    
    
