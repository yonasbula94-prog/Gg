rules_version = '2';

// PROTOTYPE rules. Review before broad sharing.
// Only the signed-in owner can read or write their own profile document.
// Every other path is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidProfile(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && data.email == request.auth.token.email
        && data.displayName is string
        && data.displayName.size() <= 200
        && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidProfile(userId)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId)
        && isValidProfile(userId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
